  "semanticTokenColors": {
    "variable": {
      "foreground": "#e8df95",
      "bold": false
    },
    "parameter": {
      "foreground": "#e8df95",
      "bold": false
    },
    "variable.declaration": {
      "foreground": "#e8df95",
      "bold": false
    },
    "parameter.declaration": {
      "foreground": "#e8df95",
      "bold": false
    },
    "property": {
      "foreground": "#e8df95",
      "bold": false
    },
    "enumMember": {
      "foreground": "#e8df95",
      "bold": false
    },
    "function": {
      "foreground": "#8fd0ff",
      "bold": false
    },
    "method": {
      "foreground": "#8fd0ff",
      "bold": false
    },
    "function.declaration": {
      "foreground": "#8fd0ff",
      "bold": false
    },
    "method.declaration": {
      "foreground": "#8fd0ff",
      "bold": false
    },
    "decorator": {
      "foreground": "#8fd0ff",
      "bold": false
    },
    "macro": {
      "foreground": "#8fd0ff",
      "bold": false
    },
    "type": {
      "foreground": "#ffffff",
      "italic": true
    },
    "class": {
      "foreground": "#ffffff",
      "italic": true
    },
    "interface": {
      "foreground": "#ffffff",
      "italic": true
    },
    "enum": {
      "foreground": "#ffffff",
      "italic": true
    },
    "typeParameter": {
      "foreground": "#ffffff",
      "italic": true
    },
    "namespace": {
      "foreground": "#ffffff",
      "italic": true
    },
    "keyword": {
      "foreground": "#ffffff",
      "bold": false
    },
    "string": {
      "foreground": "#fdaeba"
    },
    "number": {
      "foreground": "#fdaeba"
    },
    "comment": {
      "foreground": "#ffffff",
      "italic": true
    }
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#ffffff",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier",
        "keyword.other",
        "keyword.type.go"
      ],
      "settings": {
        "foreground": "#ffffff",
        "fontStyle": ""
      }
    },
    {
      "name": "Operators and punctuation",
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#ffffff",
        "fontStyle": ""
      }
    },
    {
      "name": "Variables in use",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.parameter",
        "variable.other.constant",
        "constant.other.caps",
        "variable.language",
        "support.variable",
        "support.constant",
        "entity.name.variable"
      ],
      "settings": {
        "foreground": "#e8df95",
        "fontStyle": ""
      }
    },
    {
      "name": "Variable declarations",
      "scope": [
        "meta.definition.variable variable",
        "meta.definition.variable variable.other.constant",
        "meta.definition.variable variable.other.readwrite",
        "meta.parameters variable.parameter"
      ],
      "settings": {
        "foreground": "#e8df95",
        "fontStyle": ""
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.variable.property",
        "entity.other.attribute-name",
        "variable.other.member"
      ],
      "settings": {
        "foreground": "#e8df95",
        "fontStyle": ""
      }
    },
    {
      "name": "Function definitions",
      "scope": [
        "entity.name.function",
        "meta.definition.function entity.name.function",
        "meta.definition.method entity.name.function"
      ],
      "settings": {
        "foreground": "#8fd0ff",
        "fontStyle": ""
      }
    },
    {
      "name": "Function calls",
      "scope": [
        "meta.function-call entity.name.function",
        "meta.function-call.generic",
        "support.function",
        "meta.method-call entity.name.function",
        "entity.name.function.call",
        "meta.decorator variable.other.readwrite",
        "storage.type.annotation",
        "meta.attribute.rust"
      ],
      "settings": {
        "foreground": "#8fd0ff",
        "fontStyle": ""
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "storage.type.primitive",
        "entity.name.namespace",
        "storage.type.built-in",
        "storage.type.java",
        "storage.type.generic",
        "storage.type.sql",
        "storage.type.numeric.go",
        "storage.type.boolean.go",
        "storage.type.string.go",
        "storage.type.error.go",
        "storage.type.rune.go",
        "storage.type.byte.go",
        "storage.type.uintptr.go",
        "keyword.type",
        "keyword.other.type",
        "new.expr meta.function-call entity.name.function",
        "variable.language.generic-parameter"
      ],
      "settings": {
        "foreground": "#ffffff",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string",
        "constant.character",
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#fdaeba"
      }
    },
    {
      "name": "Numbers and literals",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.language.boolean",
        "constant.other",
        "meta.delimiter.decimal",
        "constant.numeric meta.delimiter"
      ],
      "settings": {
        "foreground": "#fdaeba",
        "fontStyle": ""
      }
    },
    {
      "name": "Keys and other names",
      "scope": [
        "support.type.property-name",
        "punctuation.support.type.property-name",
        "entity.name.tag.yaml",
        "entity.other.attribute.lua",
        "constant.language.symbol.hashkey",
        "constant.other.symbol.hashkey",
        "constant.other.php",
        "constant.other.class.php",
        "constant.other.database-name",
        "constant.other.table-name",
        "punctuation.definition.variable",
        "entity.name.type.anchor",
        "entity.name.class.lua",
        "meta.create.sql entity.name.function",
        "entity.name.section.toml"
      ],
      "settings": {
        "foreground": "#e8df95",
        "fontStyle": ""
      }
    },
    {
      "name": "Parts of a literal",
      "scope": [
        "storage.type.numeric.bigint",
        "storage.type.number.python",
        "storage.type.string.python",
        "keyword.other.unit",
        "constant.numeric punctuation",
        "punctuation.definition.constant",
        "punctuation.definition.char",
        "constant.character.entity punctuation.definition.entity",
        "string.regexp keyword.operator",
        "string.regexp keyword.control",
        "string.regexp keyword.other",
        "string.regexp punctuation",
        "string.regexp punctuation.definition",
        "source.css support.constant",
        "variable.parameter.url"
      ],
      "settings": {
        "foreground": "#fdaeba",
        "fontStyle": ""
      }
    },
    {
      "name": "Code inside a string, prose inside markup",
      "scope": [
        "meta.embedded",
        "meta.template.expression",
        "meta.interpolation",
        "meta.fstring constant.character.format",
        "constant.other.symbol.hashkey punctuation.definition.constant",
        "punctuation.definition.constant.hashkey",
        "string.other.link.title"
      ],
      "settings": {
        "foreground": "#ffffff",
        "fontStyle": ""
      }
    },
    {
      "name": "Markup",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#ffffff",
        "fontStyle": ""
      }
    },
    {
      "name": "Markup emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup code and links",
      "scope": [
        "markup.inline.raw",
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#8fd0ff"
      }
    },
    {
      "name": "HTML tags",
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#8fd0ff",
        "fontStyle": ""
      }
    },
    {
      "name": "Diff",
      "scope": [
        "markup.inserted",
        "punctuation.definition.inserted"
      ],
      "settings": {
        "foreground": "#9be39d"
      }
    },
    {
      "name": "Diff removed",
      "scope": [
        "markup.deleted",
        "punctuation.definition.deleted"
      ],
      "settings": {
        "foreground": "#fdaeba"
      }
    }
  ]
}
