# neoplasticism for git
# Generated from palette.toml by build.py. Edit templates/git/neoplasticism.gitconfig instead.
# ./install.sh links this to ~/.config/git/neoplasticism.gitconfig and adds it to
# include.path in ~/.gitconfig. Colors are quoted because # starts a comment in git config.

[color "diff"]
	meta = bold "#ffffff"
	frag = "#8fd0ff"
	func = "#8fd0ff"
	old = "#fdaeba"
	new = "#9be39d"
	commit = "#e8df95"

[color "status"]
	header = "#7f7f7f"
	branch = "#e8df95"
	nobranch = "#fdaeba"
	added = "#9be39d"
	changed = "#8fd0ff"
	untracked = "#bcf2bd"
	unmerged = "#fdaeba"

[color "branch"]
	current = "#e8df95"
	local = "#ffffff"
	remote = "#8fd0ff"
	upstream = "#8fd0ff"

[color "decorate"]
	HEAD = bold "#ffffff"
	branch = "#e8df95"
	remoteBranch = "#8fd0ff"
	tag = "#fdaeba"
	stash = "#7f7f7f"

[color "grep"]
	match = bold "#e8df95"
	filename = "#8fd0ff"
	lineNumber = "#7f7f7f"
	separator = "#7f7f7f"

[color "interactive"]
	prompt = "#e8df95"
	header = "#ffffff"
	help = "#7f7f7f"
	error = "#fdaeba"
